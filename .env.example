# --- Основные настройки фермы -------------------------------------------------
# Ставка оператора в час. Нужна для расчёта EV/час: время — такой же ресурс, как деньги.
OPERATOR_HOURLY_RATE=15

# SQLite-бухгалтерия
DB_PATH=data/agent.db

# --- Канал: открытые bounty-задачи на GitHub ---------------------------------
# Токен не обязателен: публичный поиск работает и без него, но лимит 30 запросов
# в минуту. С токеном лимит выше. Нужен только read-only доступ к публичным данным.
GITHUB_TOKEN=

# Свои поисковые запросы через "|", если стандартных мало.
# BOUNTY_QUERIES=label:"💎 Bounty" state:open type:issue|"bounty" in:title state:open type:issue

# --- Канал: пассивная разведка в авторизованном scope -------------------------
# Файл можно скопировать из data/scope.example.yaml.
# Пока scope не заполнен, воркер разведки не запускается.
SCOPE_FILE=data/scope.yaml

# --- Уведомления (необязательно) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Локальная модель для черновиков планов (необязательно) -------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Основные настройки фермы -------------------------------------------------
# Ваша ставка за час. Нужна для расчёта EV/час: время — такой же ресурс, как деньги.
OPERATOR_HOURLY_RATE=15

# Ниже этой оценки (EV/час) ферма не рекомендует задачу к работе.
# Сколько задач робот ведёт одновременно в многозадачном режиме (команда «потоки»)
MULTITASK_PARALLEL=3

# Сколько работ на Taskmarket делают задачу лотереей: больше — в очередь не берём
TASKMARKET_CROWD_LIMIT=25

# Задачи Taskmarket старше этого срока не берём (часы)
TASKMARKET_MAX_AGE_HOURS=240

MIN_EV_PER_HOUR=3

# SQLite-бухгалтерия
DB_PATH=data/agent.db

# --- Триаж: проверка, свободна ли задача --------------------------------------
# Сколько задач за цикл проверять на конкуренцию (/attempt, открытые PR).
# Каждая проверка — 2 запроса к GitHub.
TRIAGE_BUDGET=6

# --- Канал: открытые bounty-задачи на GitHub ---------------------------------
# Токен не обязателен (публичный поиск работает и без него, но лимит 30 запросов
# в минуту; с токеном — 30 в минуту на поиск и 5000 в час на остальное).
GITHUB_TOKEN=

# Окно «свежести»: задачи, созданные за последние N дней, получают бонус к оценке.
# Ранний вход — главный фактор победы в bounty.
FRESH_WINDOW_DAYS=21

# Свои поисковые запросы через "|", если стандартных мало.
# BOUNTY_QUERIES=label:"💎 Bounty" state:open type:issue|"bounty" in:title state:open type:issue

# --- Канал: аудит-контесты ----------------------------------------------------
# Насколько старые контесты ещё показывать (дней с момента создания репозитория).
CONTEST_MAX_AGE_DAYS=75

# --- Канал: пассивная разведка в авторизованном scope -------------------------
# Скопируйте data/scope.example.yaml в data/scope.yaml. Пока файл не заполнен,
# воркер разведки не запускается.
SCOPE_FILE=data/scope.yaml

# --- Направление 3: площадки для агентов (выплата в USDC, без банка) ----------
# Ключ выдаётся при регистрации агента на площадке (AgentHansa: agenthansa.com,
# документация для агентов — /llms.txt). Выплата в USDC на Base, минимум 10 USDC.
AGENTHANSA_API_KEY=
# Можно переопределить адрес API, если площадка сменит домен.
AGENTHANSA_BASE_URL=https://agenthansa.com/api

# Адрес, куда приходят крипто-выплаты (USDC на Base, USDT TRC-20). Нужен, если
# карта/Stripe в вашей стране не работают. Привязать адрес нужно и на площадке.
# Проверить и сохранить: python -m agent.main кошелёк 0x… --save
# В Phantom это адрес EVM (0x…) после включения сети Base — не адрес Solana.
PAYOUT_WALLET=
# Кошелёк, привязанный к Taskmarket: им подписывается отправка работы, если
# площадка требует, чтобы заявление и подпись шли одним адресом.
TASKMARKET_WALLET=

# --- Автопилот (робот, который работает без вас) ------------------------------
# Выключить без правки файла: AUTOPILOT_ENABLED=false. Мгновенный стоп:
#   touch data/STOP
AUTOPILOT_ENABLED=true
# Границы паузы между проходами. Робот сам ускоряется, когда появляется свежая
# работа, и замедляется, когда рынок пуст.
AUTOPILOT_MIN_INTERVAL=300
AUTOPILOT_MAX_INTERVAL=3600
# Сколько артефактов (заявок, черновиков, планов) готовить за один проход.
AUTOPILOT_PREPARE=3
# Не повторять одно и то же напоминание чаще, чем раз в N часов.
AUTOPILOT_NUDGE_HOURS=6

# --- Дозор (наблюдение за роботом) --------------------------------------------
# Через сколько часов ожидания готового текста напомнить, что его нужно отправить.
WATCHDOG_NAG_HOURS=12
# Сколько проходов без находок считать затишьем канала.
WATCHDOG_QUIET_RUNS=6

# --- Проверка выплат ----------------------------------------------------------
# Страна, в которую вы получаете деньги. Используется в `plan`/`apply` и в
# дашборде: показывает рабочие каналы получения (карта через Stripe, USDC, сервис-
# посредник, зарубежный счёт) и то, что заведомо не сработает.
ELIGIBILITY_COUNTRY=

# --- Модель для планов работ (необязательно) ----------------------------------
# auto | anthropic | ollama | none
LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Сертификаты --------------------------------------------------------------
# Если в вашем окружении Python не доверяет сертификатам, укажите путь к бандлу.
# CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Уведомления (необязательно) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
